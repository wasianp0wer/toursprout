# Resolved from uv.lock by the deploy and installed on the host by pip; it is
# a build artefact, and an untracked one left in the tree would make the
# deploy's own clean-tree gate refuse every run after the first.
backend/requirements.txt
__pycache__/
.pytest_cache/
frontend/.angular/
frontend/dist/
